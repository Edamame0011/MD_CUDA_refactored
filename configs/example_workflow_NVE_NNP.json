{
    "meta": {
        "name": "test_nve_nnp_aoti", 
        "unit": "metal", 
        "seed": 12345
    }, 
    "common_settings": {
        "atoms": {
            "mode": "from_file", 
            "format": "xyz", 
            "path": "./data/sample_NS2_N2000.xyz"
        }, 
        "cell" : {
            "type": "cubic"
        }, 
        "interactions": {
            "cell_list": false, 
            "use_graph": 0, 
            "neighbour_list": {
                "cutoff": [5.0, 5.0, 5.0, 5.0], 
                "margin": 1.0
            }, 
            "potentials": {
                "type": "NNP", 
                "cutoff": 5.0, 
                "max_edges": 70000, 
                "model_path": "./models/Na2O-SiO2_aoti.pt2"
            }
        }
    }, 
    "steps": [
        {
            "name": "equilibration run", 
            "simulation": {
                "dt": 0.5, 
                "simulation_time": 5e+2, 
                "ensemble": {
                    "type": "NVT", 
                    "thermostat": "Bussi", 
                    "tau": 0.02, 
                    "seed": 12345, 
                    "temperature": 2.0, 
                    "scheduler": "constant"
                }, 
                "log_step": 1000
            }, 
            "observer": {
                "type": "log", 
                "divisions": 9
            }
        }, 
        {
            "name": "production run", 
            "simulation": {
                "dt": 0.5, 
                "simulation_time": 5e+2, 
                "cell_type": "cubic", 
                "ensemble": {
                    "type": "NVE", 
                    "temperature": 2.0
                }, 
                "log_step": 1000
            }, 
            "observer": {
                "type": "log", 
                "divisions": 9
            }, 
            "step": "reset"
        }
    ]
}