                "cutoff": [1.5, 2.0, 2.0, 1.5]
            }
        }
    }, 
    "steps": [
        {
            "name": "production run", 
            "simulation": {
                "dt": 1e-4, 
                "simulation_time": 1e+2, 
                "cell_type": "cubic", 
                "ensemble": {
                    "type": "NVE", 
                    "temperature": 2.0
