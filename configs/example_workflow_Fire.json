{
    "meta": {
        "name": "test/test_fire", 
        "unit": "lj", 
        "seed": 12345
    }, 
    "common_settings": {
        "atoms": {
            "mode": "generate_binary_lj", 
            "n_atoms": 50000, 
            "density": 1.2, 
            "ratio": [0.8, 0.2], 
            "symbol": ["X", "Y"]
        }, 
        "cell" : {
            "type": "cubic"
        }, 
        "interactions": {
            "cell_list": true, 
            "use_graph": 0, 
            "neighbour_list": {
                "cutoff": [1.5, 2.0, 2.0, 1.5], 
                "margin": 0.7, 
                "max_neighbours": 500
            }, 
            "potentials": {
                "type": "lennard_jones", 
                "numbers": [0, 1], 
                "sigma": [1.0, 0.8, 0.8, 0.88], 
                "epsilon": [1.0, 1.5, 1.5, 0.5], 
                "cutoff": [1.5, 2.0, 2.0, 1.5]
            }
        }
    }, 
    "steps": [
        {
            "name": "equilibration run", 
            "simulation": {
                "dt": 5e-3, 
                "simulation_time": 1e+2, 
                "ensemble": {
                    "type": "NVT", 
                    "thermostat": "Bussi", 
                    "tau": 0.02, 
                    "seed": 12345, 
                    "temperature": 2.0, 
                    "scheduler": "constant"
                }, 
                "log_step": 10000
            }, 
            "observer": {
                "type": "log", 
                "divisions": 9
            }
        }, 
        {
            "name": "energy minimization", 
            "minimize": {
                "type": "fire", 
                "checker": {
                    "type": "max_norm", 
                    "threshold": 1e-12
                }, 
                "params": {
                    "dt_start": 2e-3, 
                    "n_max": 5000, 
                    "t_max": 5.0, 
                    "t_min": 0.02, 
                    "n_delay": 20, 
                    "f_inc": 1.1, 
                    "f_dec": 0.5, 
                    "alpha_start": 0.25, 
                    "f_alpha": 0.99, 
                    "n_neg_max": 2000, 
                    "initialdelay": true
                }
            }, 
            "observer": {
                "type": "log", 
                "divisions": 9
            }, 
            "step": "reset", 
            "save_last_structure": {
                "path": "last_structure.xyz", 
                "is_unwrap": true
            }
        }
    ] 
}
